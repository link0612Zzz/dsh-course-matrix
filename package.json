{
  "name": "dsh-course-matrix",
  "version": "1.0.1",
  "description": "Turn a subject name or a syllabus into a ranked, audited course table. Ships a sidebar panel, three tools and a skill.",
  "type": "module",
  "license": "MIT",
  "author": "your-name",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "courses",
    "bilibili",
    "syllabus",
    "study"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
